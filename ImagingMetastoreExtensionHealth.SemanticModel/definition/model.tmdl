model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Health", "TimeZoneOption", "Lease", "BatchManifest", "Anomaly", "Alert", "Preflight", "CanaryResult", "MaintenanceRun", "ReconciliationRun", "Governance", "OrchestrationRun", "IngestionInventory", "IngestionSearch", "IngestionPipelineLog", "ExecutivePipelineRun", "ExecutivePipelineActivity", "ExecutiveTagMetrics", "PatchPipelineRun", "PatchPipelineActivity", "_Measures"]

annotation PBI_ProTooling = ["DevMode"]

ref table Health
ref table TimeZoneOption
ref table Lease
ref table BatchManifest
ref table Anomaly
ref table Alert
ref table Preflight
ref table CanaryResult
ref table MaintenanceRun
ref table ReconciliationRun
ref table Governance
ref table OrchestrationRun
ref table _Measures
ref table IngestionInventory
ref table IngestionSearch
ref table IngestionPipelineLog
ref table ExecutivePipelineRun
ref table ExecutivePipelineActivity
ref table ExecutiveTagMetrics
ref table PatchPipelineRun
ref table PatchPipelineActivity


ref cultureInfo en-US
